# App
NODE_ENV=development
PORT=4000
BACKEND_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Postgres
POSTGRES_USER=deal_radar
POSTGRES_PASSWORD=deal_radar_password
POSTGRES_DB=deal_radar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deal_radar:deal_radar_password@postgres:5432/deal_radar?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# File watching inside Docker
CHOKIDAR_USEPOLLING=true
